{
  "name": "singularity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A modern Windows research agent desktop application.",
  "author": "Singularity",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "prepare:desktop-runtime": "tsx scripts/prepare-desktop-runtime.ts",
    "update:plan": "tsx scripts/update-app.ts --dry-run",
    "update:app": "tsx scripts/update-app.ts --apply",
    "update:adopt": "tsx scripts/update-app.ts --adopt",
    "update:recover": "tsx scripts/update-app.ts --recover",
    "package:full": "tsx scripts/package-win.ts",
    "package:dir": "tsx scripts/package-win.ts --dir",
    "package:win": "tsx scripts/package-win.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean:generated": "tsx scripts/clean-generated.ts"
  },
  "dependencies": {
