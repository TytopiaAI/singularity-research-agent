# Copy to .env only for local overrides. .env is gitignored.
# Do not put API keys in this file. Singularity does not read keys from .env.
# Enter them in the first-run guide or in Settings. They are encrypted with
# Windows DPAPI and stored under the data directory.

# Optional data directory. Default is .local-data next to the project.
# SINGULARITY_DATA_ROOT=

# Optional dev-server URL used by the Electron shell.
# SINGULARITY_DEV_SERVER_URL=http://127.0.0.1:5173
